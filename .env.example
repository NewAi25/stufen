# Copy to .env.local in apps/web. Never commit real values.

# Database. Any PostgreSQL 16 or later. Local Docker default shown.
DATABASE_URL=postgres://stufen:stufen@localhost:5432/stufen

# Sign in (core-auth). Magic link by email, own code, see ADR-009.

# Files (core-storage). STORAGE_DRIVER is fs or s3.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./.data/storage
# Signs file URLs. Leave empty only for local development.
STORAGE_SIGNING_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (core-mail). MAIL_DRIVER is console or smtp.
MAIL_DRIVER=console
SMTP_URL=
# Sender address for every mail, for example Stufen <no-reply@example.org>. Required when MAIL_DRIVER=smtp.
MAIL_FROM=
# Optional reply address.
MAIL_REPLY_TO=

# AI (core-ai-tutor)
ANTHROPIC_API_KEY=
STUFEN_TUTOR_MODEL=claude-opus-5
STUFEN_GRADER_MODEL=claude-opus-5
STUFEN_CLASSIFIER_MODEL=claude-haiku-4-5
STUFEN_DEFAULT_PLAN=free_beta

# Web app (apps/web)
# Public base URL. Sign in links are built from it. Required in production, and must be https there.
APP_URL=http://localhost:3000
# Store mode. Leave empty: Postgres when DATABASE_URL is set, in memory otherwise. Set to memory to force in memory.
STUFEN_STORE=
# Optional. Folder holding content/de when it is not found next to the app.
STUFEN_CONTENT_DIR=
# Development only, in memory mode only. Signs you in as this address without a link.
STUFEN_DEV_SESSION_EMAIL=
