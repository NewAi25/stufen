{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stufen.app/schema/exam-format.json",
  "title": "Exam format",
  "description": "One element of content/<lang>/exam-formats.json, which is a JSON array. Describes a published exam as data so core-assessment can simulate it.",
  "type": "object",
  "required": ["id", "name", "level", "provider", "sections", "pass_mark", "source"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Stable id, for example goethe-a1." },
    "name": { "type": "string", "minLength": 1, "description": "Official exam name." },
    "level": { "$ref": "#/$defs/level" },
    "provider": { "type": "string", "minLength": 1 },
    "total_minutes": { "type": "integer", "minimum": 1, "description": "Whole exam including speaking, when the provider states it." },
    "max_points": { "type": "number", "minimum": 1 },
    "pass_mark": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction of max_points needed to pass." },
    "scoring_en": { "type": "string", "description": "Scoring rule in plain words. Modular exams say so here." },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    },
    "source": { "type": "string", "pattern": "^([a-z0-9][a-z0-9-]*|unverified)$" },
    "source_note": { "type": "string" },
    "reviewed": { "type": "boolean" }
  },
  "$defs": {
    "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
    "skill": {
      "enum": ["reading", "listening", "spoken_production", "spoken_interaction", "writing", "mediation", "grammar", "vocabulary"]
    },
    "section": {
      "type": "object",
      "required": ["id", "name", "skill", "task_count", "minutes", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1, "description": "Section name as printed on the exam, for example Hören." },
        "name_en": { "type": "string" },
        "skill": { "$ref": "#/$defs/skill" },
        "task_count": { "type": "integer", "minimum": 1, "description": "Number of tasks (Teile)." },
        "item_count": { "type": "integer", "minimum": 1, "description": "Number of scored items across the tasks, when known." },
        "minutes": { "type": "integer", "minimum": 1 },
        "points": { "type": "number", "minimum": 0 },
        "task_types_en": { "type": "array", "items": { "type": "string" }, "description": "Short description of each task in order." },
        "source": { "type": "string", "pattern": "^([a-z0-9][a-z0-9-]*|unverified)$" },
        "note": { "type": "string" }
      }
    }
  }
}
