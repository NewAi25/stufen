{"key":"de:chunk:ich-heisse","kind":"chunk","lemma":"Ich heiße ...","gloss_en":"My name is ...","level":"A1","source":"goethe-a1-wortliste","reviewed":false,"payload":{"slot":"your name","examples":[{"text":"Ich heiße Anna.","gloss_en":"My name is Anna."},{"text":"Ich heiße Peter Schmidt.","gloss_en":"My name is Peter Schmidt."}]}}
{"key":"de:chunk:ich-komme-aus","kind":"chunk","lemma":"Ich komme aus ...","gloss_en":"I come from ...","level":"A1","source":"goethe-a1-wortliste","reviewed":false,"payload":{"slot":"a country or city","examples":[{"text":"Ich komme aus Indien.","gloss_en":"I come from India."},{"text":"Ich komme aus Berlin.","gloss_en":"I come from Berlin."}],"note":"Countries with an article take the dative: aus der Schweiz, aus den USA. Learned as fixed forms at A1."}}
{"key":"de:chunk:ich-wohne-in","kind":"chunk","lemma":"Ich wohne in ...","gloss_en":"I live in ...","level":"A1","source":"goethe-a1-wortliste","reviewed":false,"payload":{"slot":"a city","examples":[{"text":"Ich wohne in Hamburg.","gloss_en":"I live in Hamburg."},{"text":"Ich wohne in Kolkata.","gloss_en":"I live in Kolkata."}]}}
{"key":"de:phrase:wie-heissen-sie","kind":"phrase","lemma":"Wie heißen Sie?","gloss_en":"What is your name? (formal)","level":"A1","source":"goethe-a1-wortliste","reviewed":false,"payload":{"register":"formal","reply":"Ich heiße ...","examples":[{"text":"Guten Tag! Wie heißen Sie?","gloss_en":"Good day! What is your name?"}],"note":"Informal: Wie heißt du?"}}
{"key":"de:phrase:wie-gehts","kind":"phrase","lemma":"Wie geht's?","gloss_en":"How are you? (informal)","level":"A1","source":"goethe-a1-wortliste","reviewed":false,"payload":{"register":"informal","reply":"Danke, gut.","examples":[{"text":"Hallo Tom, wie geht's?","gloss_en":"Hi Tom, how are you?"}],"note":"Short for Wie geht es dir? Formal: Wie geht es Ihnen?"}}
{"key":"de:phrase:danke-gut","kind":"phrase","lemma":"Danke, gut.","gloss_en":"Fine, thanks.","level":"A1","source":"goethe-a1-wortliste","reviewed":false,"payload":{"register":"neutral","examples":[{"text":"Wie geht's? Danke, gut. Und dir?","gloss_en":"How are you? Fine, thanks. And you?"}]}}
{"key":"de:phrase:freut-mich","kind":"phrase","lemma":"Freut mich.","gloss_en":"Nice to meet you.","level":"A1","source":"goethe-a1-wortliste","reviewed":false,"payload":{"register":"neutral","examples":[{"text":"Ich heiße Anna. Freut mich!","gloss_en":"My name is Anna. Nice to meet you!"}]}}
{"key":"de:grammar:sein-praesens","kind":"grammar","lemma":"sein, present tense","gloss_en":"forms of to be: bin, bist, ist, sind, seid, sind","level":"A1","source":"profile-deutsch","reviewed":false,"payload":{"explanation_en":"sein is irregular. Learn the six forms as a set. ich bin, du bist, er sie es ist, wir sind, ihr seid, sie Sie sind.","pattern":"ich bin, du bist, er ist, wir sind, ihr seid, sie sind","table":{"ich":"bin","du":"bist","er/sie/es":"ist","wir":"sind","ihr":"seid","sie/Sie":"sind"},"examples":[{"text":"Ich bin Anna.","gloss_en":"I am Anna."},{"text":"Du bist Tom.","gloss_en":"You are Tom."},{"text":"Das ist Frau Müller.","gloss_en":"That is Mrs Müller."}],"sequence_ref":"A1.1"}}
{"key":"de:grammar:praesens-regelmaessig","kind":"grammar","lemma":"regular verbs, present tense","gloss_en":"endings e, st, t, en, t, en on the verb stem","level":"A1","source":"profile-deutsch","reviewed":false,"payload":{"explanation_en":"Take the infinitive, remove en to get the stem, add the ending for the person. wohnen: wohn plus e, st, t, en, t, en. heißen keeps a single t in du heißt because the stem already ends in ß.","pattern":"ich wohne, du wohnst, er wohnt, wir wohnen, ihr wohnt, sie wohnen","table":{"ich":"-e","du":"-st","er/sie/es":"-t","wir":"-en","ihr":"-t","sie/Sie":"-en"},"examples":[{"text":"Ich wohne in Berlin.","gloss_en":"I live in Berlin."},{"text":"Wo wohnst du?","gloss_en":"Where do you live?"},{"text":"Sie kommt aus Wien.","gloss_en":"She comes from Vienna."}],"sequence_ref":"A1.2"}}
