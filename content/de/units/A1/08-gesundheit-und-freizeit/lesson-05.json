            "answer_index": 2
          },
          {
            "question": "Wann fängt die Feier an?",
            "options": [
              "am Samstag um 15 Uhr",
              "am Samstag um 5 Uhr",
              "am Sonntag um 15 Uhr"
            ],
            "answer_index": 0
          },
          {
            "question": "Es regnet am Samstag. Wann ist die Feier?",
            "options": [
              "am Samstag",
              "am Sonntag"
            ],
            "answer_index": 1
          },
          {
            "question": "Who is invited?",
            "options": [
              "only children",
              "everybody"
            ],
            "answer_index": 1,
            "explanation_en": "Wir laden alle ein means we invite everybody. einladen splits in two: wir laden ... ein."
          }
        ]
